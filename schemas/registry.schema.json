{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/VoltLaunchr/volt-extensions/main/schemas/registry.schema.json",
  "title": "Volt Extension Registry",
  "description": "Schema for the public Volt extension registry.json file",
  "type": "object",
  "required": ["version", "lastUpdated", "extensions"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/RegistryExtension" }
    }
  },
  "definitions": {
    "RegistryExtension": {
      "type": "object",
      "required": [
        "manifest",
        "downloadUrl",
        "downloads",
        "stars",
        "verified",
        "featured",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest": { "$ref": "#/definitions/RegistryManifest" },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/VoltLaunchr/volt-extensions/releases/download/.+\\.(zip|tar\\.gz)$"
        },
        "downloads": { "type": "integer", "minimum": 0 },
        "stars": { "type": "integer", "minimum": 0 },
        "verified": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "screenshots": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "readmeUrl": {
          "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "RegistryManifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "description",
        "author",
        "keywords",
        "prefix",
        "category",
        "repository",
        "license",
        "minVoltVersion",
        "permissions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 280 },
        "author": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "github": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          }
        },
        "icon": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "prefix": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "productivity",
            "utilities",
            "developer",
            "media",
            "social",
            "finance",
            "games",
            "system",
            "other"
          ]
        },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "minVoltVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "clipboard",
              "network",
              "notifications",
              "openUrl",
              "oauth",
              "ai",
              "system"
            ]
          }
        }
      }
    }
  }
}
