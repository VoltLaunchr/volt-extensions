{
  "name": "@voltlaunchrr/plugin-cli",
  "version": "0.1.0",
  "description": "CLI for creating, testing, and publishing Volt extensions",
  "type": "module",
  "bin": {
    "volt-plugin": "./bin/volt-plugin.mjs"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "validate:registry": "npm run build && node dist/index.js validate-registry",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "archiver": "^7.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoltLaunchr/volt-extensions.git",
    "directory": "packages/cli"
  }
}
